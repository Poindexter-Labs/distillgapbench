# Copy to .env and fill in only the providers you will call. Never commit .env.
# The operator template on output prediction needs no keys at all.
#
# Researcher and validator routes (see researchers_v6.json for which researcher uses which provider):
AZURE_OPENAI_KEY=
DISTILLGAP_AZURE_BASE_URL=          # your Azure OpenAI v1 endpoint, e.g. https://<resource>.openai.azure.com/openai/v1
AWS_BEARER_TOKEN_BEDROCK=           # Amazon Bedrock API key (Claude and Kimi K3.1 routes, region us-east-2)
GEMINI_API_KEY=
META_API_KEY=
OPENROUTER_API_KEY=                 # only for the diagnostic "kimi" route; the leaderboard uses Bedrock ("kimi31")
#
# Validators: GPT-6 Astra (Azure) validates Anthropic researchers; Claude Opus 5.5 (Bedrock) validates the rest.
# Coding and mathematics therefore need both Azure and Bedrock keys; output prediction has no validator.
#
# Hugging Face token, needed only for the gated student google/gemma-3-4b-pt (accept its licence first):
HF_TOKEN=
